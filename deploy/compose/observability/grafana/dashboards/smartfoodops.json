{
  "uid": "smartfoodops-slo",
  "title": "SmartFoodOps \u2014 SLO overview",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 9,
      "title": "Request rate by service (RPS) \u2014 the R in RED",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        },
        {
          "expr": "sum (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "TOTAL",
          "refId": "B"
        }
      ]
    },
    {
      "id": 1,
      "title": "HTTP p95 latency by service",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx ratio by service",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum by (job) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Placement p95 (fresh placements) vs the 3s SLO",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_placement_seconds_bucket{outcome=\"placed\"}[5m])))",
          "legendFormat": "p95 placed",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(order_placement_seconds_bucket{outcome=\"placed\"}[5m])))",
          "legendFormat": "p99 placed",
          "refId": "B",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Placement outcomes /min",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(order_placement_seconds_count[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Saga outcomes /10min (worker)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome, reason) (increase(order_saga_outcomes_total[10m]))",
          "legendFormat": "{{outcome}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Outbox: publish lag p99 + backlog",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(outbox_publish_lag_seconds_bucket[5m])))",
          "legendFormat": "lag p99 (s)",
          "refId": "A"
        },
        {
          "expr": "outbox_pending",
          "legendFormat": "backlog rows",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Consumers: events by result /5min",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (group, result) (increase(consumer_events_total[5m]))",
          "legendFormat": "{{group}} {{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Readiness (up) by target",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Container CPU (cores) \u2014 cAdvisor (name label empty on Docker Desktop)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum by (name, id) (rate(container_cpu_usage_seconds_total{id=~\"/docker/.+\"}[2m])))",
          "legendFormat": "{{name}}{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Container memory \u2014 cAdvisor",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, container_memory_usage_bytes{id=~\"/docker/.+\"})",
          "legendFormat": "{{name}}{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Kafka consumer lag by group (broker truth)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} {{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Worker: activity schedule\u2192start p95 + DB pool in use",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_activity_schedule_to_start_latency_bucket[5m])))",
          "legendFormat": "schedule\u2192start p95 (s)",
          "refId": "A"
        },
        {
          "expr": "db_pool_connections{state=\"in_use\"}",
          "legendFormat": "{{job}} pool in_use",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
