# Compose interpolation knobs (docker-compose.yml reads these from the shell or
# from a sibling .env file; every one has a safe default baked into the compose
# file, so no .env is required for normal dev).
#
# Chaos knobs (mock-psp) — `make chaos` raises them, `make chaos-off` restores:
#   see docs/local-dev.md §9 for what each rate injects.
DECLINE_RATE=0.0
TIMEOUT_RATE=0.0
UNKNOWN_OUTCOME_RATE=0.0
LATENCY_MS_P50=40

# Outbox publisher mode for all app services (smartfood-outbox):
#   poller (dev default, in-process) | debezium (needs the cdc profile, W3)
OUTBOX_MODE=poller
